<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ClipSync.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <!-- 应用图标：写入 EXE 的 PE 资源（资源管理器/快捷方式看到的图标） -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 仅在 Windows 平台发布时启用自包含单文件（跨平台构建不需要下载 win-x64 运行时） -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(PublishProfile)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WPF 原生库必须在启动时解压到磁盘，否则 HwndSubclass 会抛 DllNotFoundException -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 不要裁剪 WPF 程序集（会破坏 XAML 资源解析和窗口子类化） -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipSync.Core\ClipSync.Core.csproj" />
  </ItemGroup>

  <!-- 硬编码引入 System.Drawing.Common 用于剪贴板图片；版本号与 net8.0 匹配 -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- NotifyIcon 用的 WinForms 互操作 -->
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="8.0.0" />
  </ItemGroup>

  <!-- 把 app.ico 嵌入为 WPF pack://application 资源（托盘代码通过 Application.GetResourceStream 读取） -->
  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
